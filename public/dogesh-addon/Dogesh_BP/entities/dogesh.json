        "priority": 9,
        "max_dist": 8,
        "goal_radius": 2,
        "excluded_items": []
      },
      "minecraft:behavior.random_stroll": {
        "priority": 10,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 11
      },
      "minecraft:tameable": {
        "probability": 1,
        "tame_items": [
          "bone"
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "event": "dogesh:happy_bark",
              "target": "self"
            },
            "use_item": false,
            "swing": true
          }
        ]
      },
      "minecraft:celebrate": {
